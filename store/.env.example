# Store frontend — Cloudflare Pages (copy to store/.env.local for dev)

# Required for production / Cloudflare Pages builds
NEXT_PUBLIC_API_URL=https://api.example.com/api

# Optional — image CDN hostname (Cloudinary is allowed by default via res.cloudinary.com)
# NEXT_PUBLIC_IMAGES_HOST=res.cloudinary.com

# Enable customer notification inbox API (requires backend /notifications routes)
# NEXT_PUBLIC_NOTIFICATIONS_ENABLED=true
