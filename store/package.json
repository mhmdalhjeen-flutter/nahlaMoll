{
  "name": "store-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx cross-env NEXT_PUBLIC_API_URL=http://localhost:3001/api next dev -p 3000",
    "build": "next build",
    "pages:build": "next build && npx @cloudflare/next-on-pages",
    "pages:preview": "npx wrangler pages dev .vercel/output/static --compatibility-flag=nodejs_compat",
    "start": "next start -p 3000",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@serwist/next": "^9.5.12",
    "@tanstack/react-query": "^5.28.4",
    "axios": "^1.6.8",
    "clsx": "^2.1.0",
    "lucide-react": "^0.360.0",
    "next": "14.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serwist": "^9.5.12",
    "tailwind-merge": "^2.2.2",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.22",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.5",
    "vercel": "^44.7.3",
    "vitest": "^2.1.9"
  }
}
