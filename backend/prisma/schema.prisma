// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ProductAvailability {
  LIMITED // Has stock quantity
  UNLIMITED // Always available
  UNAVAILABLE // Cannot be purchased
}

enum OrderStatus {
  PENDING
  PAYMENT_SUBMITTED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum StoreWaitRequestType {
  ADD_TO_CART
  CHECKOUT
}

enum StoreWaitRequestStatus {
  WAITING
  NOTIFIED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum ProductCondition {
  NEW
  USED
}

enum OfferType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DeliveryAreaType {
  MAIN
  SUB_NEAR
  SUB_FAR
}

enum DeliveryRegion {
  NORTH
  GAZA
  MIDDLE
  SOUTH
}

enum CustomerInteractionType {
  // Store assistant (chatbot)
  CHAT_SEARCH
  CHAT_PRODUCT_CLICK
  CHAT_INTENT
  CHAT_CATEGORY_CLICK
  CHAT_CATEGORY_INTERACTION
  CHAT_BASKET_REQUEST
  CHAT_BASKET_ACCEPTED
  CHAT_BASKET_PRODUCT_SELECTION
  // Store-wide behavioral signals (Phase 0 foundation)
  PRODUCT_VIEWED
  PRODUCT_CLICKED
  SEARCH_QUERY
  SEARCH_RESULT_CLICK
  SEARCH_NO_RESULTS
  CATEGORY_VIEWED
  CATEGORY_CLICKED
  CART_ITEM_ADDED
  CART_ITEM_REMOVED
  CART_QUANTITY_CHANGED
  FAVORITE_ADDED
  FAVORITE_REMOVED
  CHECKOUT_STARTED
  ORDER_CREATED
  ORDER_COMPLETED
  ORDER_CANCELLED
  RECOMMENDATION_SHOWN
  RECOMMENDATION_CLICKED
  RECOMMENDATION_ADDED_TO_CART
  RECOMMENDATION_PURCHASED
  RECOMMENDATION_DISMISSED
}

model User {
  id              String   @id @default(cuid())
  phoneNumber     String   @unique
  name            String?
  email           String?  @unique
  passwordHash    String?
  role            UserRole @default(CUSTOMER)
  isPhoneVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  addresses       Address[]
  cartItems       CartItem[]
  orders          Order[]
  favorites       Favorite[]
  reviews         Review[]
  supportMessages SupportMessage[]
  auditLogs       AuditLog[]
  storeWaitRequests StoreWaitRequest[]
  customerInteractions CustomerInteraction[]
  notificationPreferences CustomerNotificationPreferences?

  @@index([phoneNumber])
  @@index([email])
}

model OtpRecord {
  id          String   @id @default(cuid())
  phoneNumber String
  code        String
  expiresAt   DateTime
  attempts    Int      @default(0)
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([phoneNumber])
  @@index([expiresAt])
}

// ============================================
// ADDRESSES & DELIVERY
// ============================================

model Address {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryAreaId  String
  deliveryArea    DeliveryArea @relation(fields: [deliveryAreaId], references: [id])
  detailedAddress String
  isDefault       Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([deliveryAreaId])
}

model DeliveryArea {
  id                      String           @id @default(cuid())
  name                    String // Arabic
  nameEn                  String? // English for admin
  deliveryFee             Decimal
  eligibleForFreeDelivery Boolean          @default(true)
  isActive                Boolean          @default(true)
  areaType                DeliveryAreaType @default(MAIN)
  region                  DeliveryRegion?
  parentId                String?
  parent                  DeliveryArea?    @relation("DeliveryAreaHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                DeliveryArea[]   @relation("DeliveryAreaHierarchy")
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  // Relations
  addresses Address[]
  orders    Order[]

  @@index([isActive])
  @@index([parentId])
  @@index([areaType])
  @@index([region])
}

// ============================================
// PRODUCTS & CATEGORIES
// ============================================

model Category {
  id          String     @id @default(cuid())
  name        String // Arabic
  nameEn      String? // English for admin
  slug        String     @unique
  description String?
  image       String?
  isActive    Boolean    @default(true)
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([isActive])
  @@index([parentId])
}

model Product {
  id                String              @id @default(cuid())
  name              String // Arabic
  nameEn            String? // English for admin
  description       String // Arabic
  descriptionEn     String? // English for admin
  categoryId        String
  category          Category            @relation(fields: [categoryId], references: [id])
  price             Decimal
  freeDeliveryValue         Decimal @default(0) // MAIN area contribution (%)
  freeDeliveryValueSubNear  Decimal @default(0) // SUB_NEAR contribution (%)
  freeDeliveryValueSubFar   Decimal @default(0) // SUB_FAR contribution (%)
  availability      ProductAvailability @default(UNLIMITED)
  stock             Int                 @default(0)
  isAvailable       Boolean             @default(true)
  isRecommended     Boolean             @default(false)
  isActive          Boolean             @default(true)
  condition         ProductCondition    @default(NEW)
  tags              String[]
  images            String[]

  // Offer fields
  hasOffer       Boolean    @default(false)
  offerType      OfferType?
  offerValue     Decimal?
  offerStartDate DateTime?
  offerEndDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  cartItems  CartItem[]
  orderItems OrderItem[]
  variants   ProductVariant[]
  favorites  Favorite[]
  reviews    Review[]

  @@index([categoryId])
  @@index([availability])
  @@index([isAvailable])
  @@index([isActive])
  @@index([isRecommended])
  @@index([hasOffer])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String // e.g., "Red"
  value           String // e.g., "#FF0000"
  type            String // e.g., "color"
  priceAdjustment Decimal  @default(0)
  stock           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cartItems CartItem[]

  @@index([productId])
}

// ============================================
// CART
// ============================================

model CartItem {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int             @default(1)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, productId, variantId])
  @@index([userId])
  @@index([productId])
}

// ============================================
// ORDERS & PAYMENTS (future scope - preserved)
// ============================================

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  customerId    String
  customer      User          @relation(fields: [customerId], references: [id])
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  subtotal    Decimal
  deliveryFee Decimal
  total       Decimal
  cartScore   Decimal

  deliveryAreaId  String
  deliveryArea    DeliveryArea @relation(fields: [deliveryAreaId], references: [id])
  deliveryAddress String

  // Payment information
  paymentReference  String?
  paymentProof      String?
  paymentNotes      String?
  adminPaymentNotes String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items OrderItem[]

  @@index([customerId])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderNumber])
  @@index([createdAt])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  productName       String // Snapshot at time of order
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity          Int
  price             Decimal // Snapshot at time of order
  freeDeliveryValue Decimal // Snapshot at time of order
  variantInfo       String? // JSON snapshot of variant info
  createdAt         DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

// ============================================
// CUSTOMER FEATURES (future scope - preserved)
// ============================================

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// Structured shopping signals from the store assistant (not raw chat transcripts).
model CustomerInteraction {
  id         String                  @id @default(cuid())
  userId     String?
  user       User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String?
  type       CustomerInteractionType
  searchTerm String?
  productId  String?
  categoryId String?
  intent     String?
  context    String?
  metadata   Json?
  source     String                  @default("store")
  createdAt  DateTime                @default(now())

  @@index([userId, createdAt])
  @@index([userId, type])
  @@index([sessionId, createdAt])
  @@index([productId])
}

// Per-customer notification delivery preferences (future delivery engine reads these).
model CustomerNotificationPreferences {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderUpdates            Boolean  @default(true)
  freeDelivery            Boolean  @default(true)
  favorites               Boolean  @default(false)
  offers                  Boolean  @default(false)
  personalRecommendations Boolean  @default(false)
  newProducts             Boolean  @default(false)
  abuAlaaNews             Boolean  @default(false)

  pushEnabled             Boolean  @default(false)
  emailEnabled            Boolean  @default(false)

  doNotDisturbEnabled     Boolean  @default(false)
  doNotDisturbFrom        String?  // HH:mm local time, e.g. "22:00"
  doNotDisturbUntil       String?  // HH:mm local time, e.g. "08:00"

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
  @@index([productId, createdAt(sort: Desc)])
  @@index([rating])
}

// ============================================
// STORE SETTINGS & ANNOUNCEMENTS
// ============================================

enum PaymentMethodType {
  BANK_OF_PALESTINE
  PALPAY
  JAWWAL_PAY
}

model PaymentAccount {
  id            String            @id @default(cuid())
  method        PaymentMethodType
  accountName   String
  accountNumber String
  qrImageUrl    String?
  isActive      Boolean           @default(false)
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([method])
  @@index([method, isActive])
}

model Settings {
  id               String  @id @default(cuid())
  storeName        String // Arabic
  storeNameEn      String? // English
  storePhone       String?
  storeEmail       String?
  socialMediaLinks Json?

  // Store status
  isStoreOpen        Boolean @default(true)
  storeClosedMessage String? // Arabic

  // Free delivery settings
  freeDeliveryTarget           Decimal
  partialFreeDeliveryEnabled   Boolean @default(false)
  partialFreeDeliveryThreshold Decimal
  partialFreeDeliveryDiscount  Int     @default(50)

  // Payment instructions (legacy manual transfer — synced from active accounts)
  paymentInstructions     String? // Arabic
  paymentInstructionsEn   String? // English
  paymentQrImage          String?
  paymentAccountDetails   String? // Arabic
  paymentAccountDetailsEn String? // English

  // Cash on delivery
  codEnabled Boolean @default(false)
  codNote    String?

  // Electronic payment method toggles
  bankOfPalestineEnabled Boolean @default(false)
  palPayEnabled          Boolean @default(false)
  jawwalPayEnabled       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String    @id @default(cuid())
  title     String // Arabic
  titleEn   String? // English
  content   String // Arabic
  contentEn String? // English
  image     String?
  isActive  Boolean   @default(true)
  priority  Int       @default(0)
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive])
  @@index([startDate])
  @@index([endDate])
}

model SupportMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  subject   String
  message   String
  isAdmin   Boolean  @default(false)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([isRead])
}

model StoreWaitRequest {
  id        String                 @id @default(cuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      StoreWaitRequestType
  status    StoreWaitRequestStatus @default(WAITING)
  payload   Json
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([userId, status])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}
