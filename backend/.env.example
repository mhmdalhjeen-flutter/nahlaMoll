# =============================================================================
# Backend environment (copy to backend/.env — never commit .env)
# =============================================================================

# PostgreSQL — required
# Local:  postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public
# Neon (app runtime — pooled): postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/DATABASE?sslmode=require
# Neon (migrations — direct):   postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/arabic_ecommerce?schema=public"
# Direct/unpooled URL for Prisma Migrate (Neon: hostname without -pooler). Optional for local Postgres — copy DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/arabic_ecommerce?schema=public"

# Server
NODE_ENV=development
PORT=3001
BACKEND_PORT=3001
BACKEND_URL=https://api.example.com
API_PREFIX=api

# JWT — required in production (min 32 characters)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=30d

# CORS — required in production (comma-separated, no wildcard)
# Example: https://store-xxx.pages.dev,https://admin-xxx.pages.dev
CORS_ORIGINS=

# Legacy CORS aliases (optional if CORS_ORIGINS is set)
STORE_FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3002

# Seed (required when running npm run prisma:seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-min-12-chars
SEED_ADMIN_PHONE=0590000000
SEED_ADMIN_NAME=مدير النظام

# OTP
OTP_EXPIRES_IN=10m
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT=5

# Storage — local for development; cloudinary for production (recommended)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# Preferred: discrete Cloudinary credentials (backend only — never commit real secrets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Fallback only when discrete vars above are not all set:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Optional root folder prefix inside your Cloudinary account
CLOUDINARY_FOLDER=jaka

# Cloudflare R2 (only when STORAGE_PROVIDER=r2 — do not commit real values)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=https://cdn.example.com

# Observability (Stage 5)
# Log requests slower than this threshold at warning level (milliseconds)
SLOW_REQUEST_MS=1000

# Rate limiting (@nestjs/throttler v5: ttl is in MILLISECONDS, not seconds)
# 60000 = 60 second window; 100 requests per window per IP per route (global default)
# Auth OTP routes use stricter @Throttle() on AuthController (5/min send-otp, 10/min verify-otp)
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Local k6 load testing ONLY (never enable in production)
# Raises the global per-route ceiling while keeping throttling active.
# Requires backend restart. Auth OTP limits are unchanged.
# LOAD_TEST_MODE=true
# LOAD_TEST_RATE_LIMIT_MAX=5000

# Security
BCRYPT_ROUNDS=12

# Web Push (optional — push delivery disabled until all three are set)
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# SMS (optional)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
